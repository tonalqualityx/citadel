{
 "name": "email yes confirms the summary",
 "world": {
  "sites": 1,
  "role": "owner",
  "pages": [
   {
    "title": "Home",
    "path": "/"
   },
   {
    "title": "About",
    "path": "/about/",
    "sections": [
     {
      "key": "team",
      "heading": "The team"
     },
     {
      "key": "story",
      "heading": "Our story"
     }
    ]
   }
  ]
 },
 "steps": [
  {
   "client": {
    "text": "Please swap my headshot on the About page, team section."
   },
   "engine": [
    {
     "result": {
      "reply": "Here is your request as I have it. Check it before it goes to the team.",
      "actions": [
       {
        "type": "record",
        "site_id": "{{site:0}}",
        "attachment_ids": [],
        "request_type": "site_change"
       },
       {
        "type": "propose_summary",
        "summary": "On the About page, in the team section, swap the headshot.",
        "request_type": "site_change",
        "site_id": "{{site:0}}",
        "page_id": "{{page:About}}",
        "section": "team",
        "change": "Swap the headshot.",
        "attachment_ids": []
       }
      ],
      "sources": []
     }
    }
   ],
   "expect": {
    "state": "confirming",
    "pending_kind": "summary"
   }
  },
  {
   "email": {
    "text": "Yes, send it"
   },
   "engine": [
    {
     "result": {
      "reply": "Thanks. I have sent your request to the team.",
      "actions": [
       {
        "type": "confirm_from_email",
        "summary_version": 1
       }
      ],
      "sources": []
     }
    }
   ],
   "expect": {
    "email_status": "ingested",
    "state": "filed",
    "tags_include": [
     "kind:site-change"
    ],
    "tags_exclude": [
     "chat-clarifying"
    ]
   }
  }
 ]
}