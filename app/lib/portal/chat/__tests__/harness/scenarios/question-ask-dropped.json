       }
      ],
      "sources": [
       {
        "tool_call_id": "{{tc:0}}",
        "label": "Google Analytics, Oct 1 to Oct 20, 2026 (data through Oct 20)",
        "range": "2026-10-01 to 2026-10-20"
       }
      ]
     }
    }
