{
 "name": "vague text change",
 "world": {
  "sites": 1,
  "role": "owner",
  "pages": [
   {
    "title": "Home",
    "path": "/"
   },
   {
    "title": "About",
    "path": "/about/",
    "sections": [
     {
      "key": "team",
      "heading": "The team"
     },
     {
      "key": "story",
      "heading": "Our story"
     }
    ]
   },
   {
    "title": "Menu",
    "path": "/menu/"
   },
   {
    "title": "Contact",
    "path": "/contact/"
   }
  ]
 },
 "steps": [
  {
   "client": {
    "text": "Can you update the text on our site?"
   },
   "engine": [
    {
     "result": {
      "reply": "I'm Indelible's AI assistant. Which page has the text?",
      "actions": [
       {
        "type": "record",
        "site_id": "{{site:0}}",
        "attachment_ids": [],
        "request_type": "site_change"
       },
       {
        "type": "ask",
        "slot": "page",
        "question": "Which page has the text?",
        "choice_ids": [
         "{{page:Home}}",
         "{{page:About}}",
         "{{page:Menu}}",
         "{{page:Contact}}"
        ],
        "allow_free_text": true,
        "allow_upload": false
       }
      ],
      "sources": []
     }
    }
   ],
   "expect": {
    "pending_slot": "page",
    "title_starts": "Site change:"
   }
  },
  {
   "client": {
    "text": "The home page. The hours changed."
   },
   "engine": [
    {
     "result": {
      "reply": "What are the new hours?",
      "actions": [
       {
        "type": "record",
        "page_id": "{{page:Home}}",
        "change": "Update the hours.",
        "attachment_ids": []
       },
       {
        "type": "ask",
        "slot": "change",
        "question": "What are the new hours?",
        "choice_ids": [],
        "allow_free_text": true,
        "allow_upload": false
       }
      ],
      "sources": []
     }
    }
   ],
   "expect": {
    "pending_slot": "change",
    "slots": {
     "change": "Update the hours."
    }
   }
  }
 ]
}