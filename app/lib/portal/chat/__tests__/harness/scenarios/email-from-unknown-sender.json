        "request_type": "site_change"
       },
       {
        "type": "ask",
        "slot": "page",
        "question": "Which page should this photo go on?",
        "choice_ids": [
         "{{page:About}}",
         "{{page:Home}}",
         "{{page:Menu}}"
        ],
        "allow_free_text": true,
        "allow_upload": false
       }
      ],
      "sources": []
     }
    }
   ],
   "expect": {
    "route": "queued",
    "pending_slot": "page",
    "assistant_comments": 1,
    "outbox_count": 0,
    "state": "clarifying"
   }
  },
  {
   "email": {
    "text": "Please send me the invoice",
    "from": "stranger"
   },
   "expect": {
